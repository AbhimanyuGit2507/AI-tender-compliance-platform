# ────────────────────────────────────────────────────────────────
# BidKaro Backend — Environment Configuration Template
# Copy to .env and fill in your values
# ────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-strong-random-secret-32-chars-min
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bidkaro:bidkaro@localhost:5432/bidkaro
DATABASE_URL_SYNC=postgresql+psycopg2://bidkaro:bidkaro@localhost:5432/bidkaro

# ── Redis / Celery ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Object Storage (Cloudflare R2 / S3-compatible) ───────────────
STORAGE_BACKEND=local            # "local" | "r2" | "s3"
STORAGE_LOCAL_PATH=./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bidkaro-documents
R2_PUBLIC_URL=

# ── LLM Architecture Mode ─────────────────────────────────────────
# "openrouter" (Unified Single Wallet - Recommended) | "multi_direct" | "ollama"
LLM_PROVIDER=openrouter

# ── Option A: OpenRouter Unified Hub (Single API Key & Single Wallet) ─────
# Sign up at https://openrouter.ai, add funds ($5 or $10), create API key:
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Tier 1: Frontier NIT Fact Extraction & RAG (Gemini 2.0 Flash 1M context, ~$0.10/1M in, $0.40/1M out)
OPENROUTER_MODEL_FAST_TEXT=google/gemini-2.0-flash-001
# Tier 2: Multimodal OCR for Scanned PDFs (~$0.10/1M in, $0.40/1M out)
OPENROUTER_MODEL_OCR=google/gemini-2.0-flash-001
# Tier 3: Gold Standard Technical Methodology (Claude 3.5 Sonnet — #1 engineering prose in the world)
OPENROUTER_MODEL_REASONING=anthropic/claude-3.5-sonnet
# Tier 4: Forensic Pre-Flight Submission Audit (OpenAI o3-mini / Claude 3.5 Sonnet / DeepSeek-R1)
OPENROUTER_MODEL_AUDIT=openai/o3-mini

# ── Option B: Direct Multi-Provider Keys (Circuit Breaker Fallbacks) ──────
# Tier 1 — Fast Text & Extraction (Groq)
MODEL_FAST_TEXT=llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Tier 2 — Multimodal / OCR Fallback (Google Gemini)
MODEL_MULTIMODAL_OCR=gemini-2.0-flash
GEMINI_API_KEY=

# Tier 3 — Reasoning & Bid Narrative (DeepSeek via OpenRouter, Groq 70B, or Gemini Pro)
MODEL_REASONING=llama-3.3-70b-versatile
MODEL_REASONING_PROVIDER=openrouter   # "openrouter" | "groq" | "gemini" | "ollama"

# ── Option C: Free & Local LLM Options (100% Free Testing via Ollama) ─────
# Run `ollama pull llama3.1:8b` (Ollama service runs on localhost:11434)
# Set LLM_PROVIDER=ollama or MODEL_REASONING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ── Embeddings & Cross-Encoder Reranker (10/10 RAG) ──────────────
EMBEDDING_PROVIDER=fastembed     # "fastembed" | "gemini" | "openai"
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_ENABLED=true
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
RERANKER_TOP_K=6
# OPENAI_API_KEY= (only needed if EMBEDDING_PROVIDER=openai)

# ── Token / Cost Budget Controls ─────────────────────────────────
# Max tokens to send to Tier-1 LLM per call (guards cost)
MAX_EXTRACTION_TOKENS=32000
# INR per 1M tokens for cost logging
COST_TIER1_INPUT_INR=6.25       # ~$0.075/1M at 83 INR/USD
COST_TIER1_OUTPUT_INR=24.9      # ~$0.30/1M
COST_TIER2_INPUT_INR=20.75      # ~$0.25/1M
COST_TIER2_OUTPUT_INR=124.5     # ~$1.50/1M
COST_TIER3_INPUT_INR=12.45      # ~$0.15/1M
COST_TIER3_OUTPUT_INR=49.8      # ~$0.60/1M

# ── Credit System ─────────────────────────────────────────────────
FREE_TRIAL_CREDITS=25
CREDITS_PER_TENDER=100
ANON_MAX_COST_INR=0.15          # Max cost per anonymous upload

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
